{
  "name": "@react-epub-reader/reader",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@react-epub-reader/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "@react-epub-reader/source": "./src/types/index.ts",
      "types": "./dist/types/index.d.ts"
    },
    "./style.css": {
      "@react-epub-reader/source": "./src/style.dev.css",
      "default": "./dist/index.css"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepare": "node ./scripts/ensure-dist.mjs",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  }
}
